# go-task-backend Environment Variables
# Copy this file to .env and fill in the values

# ======================
# DATABASE
# ======================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=gotaskdb
DB_PORT=5432

# ======================
# JWT AUTHENTICATION
# ======================
SECRET_KEY=your_super_secret_key_here

# ======================
# MIGRATIONS
# ======================
# Connection URL for golang-migrate (optional, will use DB_* vars if not set)
MIGRATION_URL=
# Path to migrations folder (optional, defaults to ./migrations)
MIGRATIONS_PATH=

# ======================
# APPLICATION
# ======================
# App URL for generating invite links
APP_URL=http://localhost:8080
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ======================
# EMAIL / SMTP
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@email.com
# Invitation expiry in hours (default: 168 = 7 days)
INVITE_EXPIRY_HOURS=168